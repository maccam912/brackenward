class_name AsyncSaveTests
extends RefCounted

class GatedQueue extends ColonySaveQueue:
	var gate: Semaphore = Semaphore.new()
	func _write(writer: ColonyStore, captured: Dictionary, trace: Array[Dictionary], catalog: Dictionary, full_snapshot: bool) -> Dictionary:
		gate.wait()
		return super._write(writer,captured,trace,catalog,full_snapshot)

static func run(tree: SceneTree, check: Callable) -> void:
	var root: String = "user://async-save-tests-%d" % Time.get_ticks_usec()
	content3_upgrade(root,check)
	content4_upgrade(root,check)
	var world: ColonyWorld = ColonyTests.world()
	var store: ColonyStore = ColonyStore.new();store.directory=root.path_join("campaign")
	check.call("SAVE/async_fixture_snapshot",store.save(world).is_empty())
	world.queue_command("preference",{"citizen":1,"category":"Cooking","value":3});world.step()
	var captured_hash: String = world.canonical_hash()
	var captured_tick: int = world.tick
	var queue: GatedQueue = GatedQueue.new()
	check.call("SAVE/async_capture_starts_one_writer",queue.start(store,world).is_empty() and queue.busy() and not queue.start(store,world).is_empty())
	var later: int = world.queue_command("preference",{"citizen":2,"category":"Building","value":3});world.step()
	for frame in range(4): await tree.process_frame
	check.call("SAVE/async_wait_never_blocks_frames_or_acknowledges_early",queue.poll().is_empty() and store.journal_tick==1800 and world.receipts.get(later)=="accepted")
	queue.gate.post()
	var result: Dictionary = queue.poll(true)
	var recovered: Dictionary = load_saved(store)
	check.call("SAVE/async_recovers_exact_capture_while_live_sim_advances",result.error.is_empty() and result.tick==captured_tick and recovered.has("world") and recovered.world.canonical_hash()==captured_hash and world.tick==captured_tick+1,str(recovered.get("error","")))
	check.call("SAVE/async_keeps_commands_accepted_after_capture",world.command_trace.size()==1 and world.command_trace[0].command.id==later)
	check.call("SAVE/async_next_checkpoint_starts",queue.start(store,world).is_empty())
	queue.gate.post();result=queue.poll(true);recovered=load_saved(store)
	check.call("SAVE/async_next_checkpoint_recovers_newer_commands_once",result.error.is_empty() and recovered.has("world") and recovered.world.canonical_hash()==world.canonical_hash() and world.command_trace.is_empty() and store.journal_sequence==4)
	world.step();captured_hash=world.canonical_hash()
	check.call("SAVE/async_full_snapshot_starts",queue.start(store,world,true).is_empty())
	queue.gate.post();result=queue.poll(true);recovered=load_saved(store)
	check.call("SAVE/async_full_snapshot_rotates_verified_generations",result.error.is_empty() and result.snapshot and store.sequence==2 and recovered.has("world") and recovered.world.canonical_hash()==captured_hash)
	# A real filesystem failure must leave the live trace available for retry.
	var failing: ColonyStore = ColonyStore.new();failing.directory=root.path_join("failed-campaign")
	var blocked: String = failing.directory.path_join("snapshot-0000000001.brackenward.tmp")
	DirAccess.make_dir_recursive_absolute(blocked)
	var file: FileAccess = FileAccess.open(blocked.path_join("evidence"),FileAccess.WRITE);file.store_string("retain");file.close()
	world.queue_command("preference",{"citizen":3,"category":"Growing","value":3});world.step()
	var pending_trace: Array[Dictionary] = world.command_trace.duplicate(true)
	queue.start(failing,world);queue.gate.post();result=queue.poll(true)
	check.call("SAVE/async_failed_write_keeps_live_trace_and_sequence",not result.error.is_empty() and failing.sequence==0 and world.command_trace==pending_trace and FileAccess.get_file_as_string(blocked.path_join("evidence"))=="retain")
	CampaignTests.remove_tree(blocked)
	queue.start(failing,world);queue.gate.post();result=queue.poll(true);recovered=load_saved(failing)
	check.call("SAVE/async_failed_write_retries_latest_state",result.error.is_empty() and recovered.has("world") and recovered.world.canonical_hash()==world.canonical_hash() and world.command_trace.is_empty())
	prefix_integrity(root,check)
	verified_generation_integrity(root,check)
	legacy_delta_upgrade(root,queue,check)
	delta_anchor_integrity(root,check)
	CampaignTests.remove_tree(root)

static func delta_anchor_integrity(root: String, check: Callable) -> void:
	var world: ColonyWorld = ColonyTests.world()
	var store: ColonyStore = ColonyStore.new();store.directory=root.path_join("delta-parent")
	store.save(world);world.step();store.checkpoint(world)
	var snapshot: String = store.directory.path_join("snapshot-0000000001.brackenward")
	var path: String = store.directory.path_join("journal-0000000001.frames")
	var parsed: Dictionary = ColonyJournal.read(FileAccess.get_file_as_bytes(path))
	parsed.records[-1].delta.parent="0".repeat(64)
	var damaged: PackedByteArray = ColonyJournal.frame(parsed.records[-1])
	var file: FileAccess = FileAccess.open(path,FileAccess.WRITE);file.store_buffer(damaged);file.close()
	var readable: Dictionary = ColonyJournal.read(damaged)
	var reader: ColonyStore = ColonyStore.new();reader.directory=store.directory
	check.call("SAVE/valid_frame_digest_cannot_hide_wrong_delta_parent",not readable.has("error") and reader.load_latest().has("error"))
	for index in range(5): world.step();store.save(world)
	check.call("SAVE/pruning_retains_snapshot_and_semantically_corrupt_journal",FileAccess.file_exists(snapshot) and FileAccess.get_file_as_bytes(path)==damaged and store._generations().size()==4 and reader.load_latest().world.canonical_hash()==world.canonical_hash())
	store=ColonyStore.new();store.directory=root.path_join("changed-base")
	world=ColonyTests.world();store.save(world);world.step();store.checkpoint(world)
	snapshot=store.directory.path_join("snapshot-0000000001.brackenward")
	path=store.directory.path_join("journal-0000000001.frames")
	var original_journal: PackedByteArray = FileAccess.get_file_as_bytes(path)
	var changed: ColonyWorld = ColonyTests.world();changed.care_state.mode="Hearthside"
	var changed_bytes: PackedByteArray = ColonyCodec.encode(changed)
	file=FileAccess.open(snapshot,FileAccess.WRITE);file.store_buffer(changed_bytes);file.close()
	for index in range(5): world.step();store.save(world)
	check.call("SAVE/journal_pruning_cache_is_bound_to_snapshot_bytes",FileAccess.get_file_as_bytes(snapshot)==changed_bytes and FileAccess.get_file_as_bytes(path)==original_journal and store._generations().size()==4 and load_saved(store).world.canonical_hash()==world.canonical_hash())
	store=ColonyStore.new();store.directory=root.path_join("missing-journal")
	world=ColonyTests.world();store.save(world);world.step();store.checkpoint(world)
	path=store.directory.path_join("journal-0000000001.frames");DirAccess.remove_absolute(path)
	var acknowledged: int = store.journal_tick
	world.queue_command("food_policy",{"enabled":true});world.step()
	var trace: Array = world.command_trace.duplicate(true)
	var error: String = store.checkpoint(world)
	check.call("SAVE/missing_journal_does_not_acknowledge_new_progress",not error.is_empty() and store.recovered and store.journal_tick==acknowledged and world.command_trace==trace and not FileAccess.file_exists(path))
	check.call("SAVE/missing_journal_retry_snapshots_exact_memory_state",store.checkpoint(world).is_empty() and load_saved(store).world.canonical_hash()==world.canonical_hash())
	store=ColonyStore.new();store.directory=root.path_join("missing-base")
	world=ColonyTests.world();store.save(world);world.step();store.checkpoint(world)
	snapshot=store.directory.path_join("snapshot-0000000001.brackenward")
	path=store.directory.path_join("journal-0000000001.frames")
	var original: PackedByteArray = FileAccess.get_file_as_bytes(path)
	DirAccess.remove_absolute(snapshot);world.step();error=store.checkpoint(world)
	check.call("SAVE/missing_delta_base_fails_before_journal_append",not error.is_empty() and store.recovered and FileAccess.get_file_as_bytes(path)==original)
	for index in range(5): world.step();store.save(world)
	check.call("SAVE/unexpected_orphan_journal_is_retained_after_later_rotations",FileAccess.get_file_as_bytes(path)==original and load_saved(store).world.canonical_hash()==world.canonical_hash())
	var other: ColonyWorld = ColonyWorld.new(ColonyCatalog.load_data(),"foreign-delta-campaign")
	other.tick=world.tick+1
	var sequence: int = store.sequence
	check.call("SAVE/foreign_campaign_cannot_append_to_delta_chain",not store.checkpoint(other).is_empty() and store.sequence==sequence and store.journal_tick==world.tick)

static func legacy_delta_upgrade(root: String, queue: GatedQueue, check: Callable) -> void:
	var store: ColonyStore = ColonyStore.new();store.directory=root.path_join("v4-upgrade")
	DirAccess.make_dir_recursive_absolute(store.directory)
	var bytes: PackedByteArray = FileAccess.get_file_as_bytes("res://tests/fixtures/campaign-replay-7200.brackenward")
	var decoded: Dictionary = ColonyCodec.decode(bytes)
	if not decoded.has("world"): check.call("SAVE/v4_upgrade_fixture_decodes",false,str(decoded));return
	var world: ColonyWorld = decoded.world;world.step()
	var journal: PackedByteArray = ColonyJournal.frame({"sequence":"1","kind":"tick","tick":world.tick,"state":world.payload()})
	var path: String = store.directory.path_join("snapshot-0000000001.brackenward")
	var file: FileAccess = FileAccess.open(path,FileAccess.WRITE);file.store_buffer(bytes);file.close()
	file=FileAccess.open(store.directory.path_join("journal-0000000001.frames"),FileAccess.WRITE);file.store_buffer(journal);file.close()
	var recovered: Dictionary = store.load_latest()
	check.call("SAVE/v4_snapshot_and_full_state_journal_upgrade_without_replay_drift",recovered.has("world") and recovered.world.canonical_hash()==world.canonical_hash() and FileAccess.get_file_as_bytes(path)==bytes and FileAccess.get_file_as_bytes(store.directory.path_join("migration-backup-snapshot-0000000001.brackenward"))==bytes and FileAccess.get_file_as_bytes(store.directory.path_join("migration-backup-journal-0000000001.frames"))==journal)
	world.step();queue.start(store,world);queue.gate.post()
	var result: Dictionary = queue.poll(true)
	recovered=load_saved(store)
	var header: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(store.directory.path_join("snapshot-0000000002.brackenward")))
	check.call("SAVE/async_upgrade_writes_v5_and_keeps_exact_latest_tick",result.error.is_empty() and result.snapshot and header.version==5 and recovered.has("world") and recovered.world.canonical_hash()==world.canonical_hash() and FileAccess.get_file_as_bytes(path)==bytes)

static func prefix_integrity(root: String, check: Callable) -> void:
	var world: ColonyWorld = ColonyTests.world()
	var store: ColonyStore = ColonyStore.new();store.directory=root.path_join("prefix-integrity")
	store.save(world);world.step();store.checkpoint(world)
	var path: String = store.directory.path_join("journal-0000000001.frames")
	var damaged: PackedByteArray = FileAccess.get_file_as_bytes(path);damaged[12]=damaged[12]^1
	var file: FileAccess = FileAccess.open(path,FileAccess.WRITE);file.store_buffer(damaged);file.close()
	world.queue_command("preference",{"citizen":1,"category":"Cooking","value":3});world.step()
	var pending: Array[Dictionary] = world.command_trace.duplicate(true)
	var error: String = store.checkpoint(world)
	check.call("SAVE/tail_verification_detects_changed_prior_bytes",not error.is_empty() and store.recovered and store.journal_tick==1801 and world.command_trace==pending and FileAccess.get_file_as_bytes(path)==damaged)
	check.call("SAVE/changed_prefix_retry_rotates_without_overwrite",store.checkpoint(world).is_empty() and store.sequence==2 and FileAccess.get_file_as_bytes(path)==damaged and load_saved(store).world.canonical_hash()==world.canonical_hash())
	var tail: PackedByteArray = ColonyJournal.frame({"sequence":"4","kind":"tick","tick":1802})
	check.call("SAVE/tail_reader_requires_exact_initial_sequence",not ColonyJournal.read(tail,4).has("error") and ColonyJournal.read(tail,3).has("error") and ColonyJournal.read(tail,0).has("error"))

static func verified_generation_integrity(root: String, check: Callable) -> void:
	var world: ColonyWorld = ColonyTests.world()
	var store: ColonyStore = ColonyStore.new();store.directory=root.path_join("verified-generations")
	for index in range(3): store.save(world);world.step()
	var path: String = store.directory.path_join("snapshot-0000000001.brackenward")
	var bytes: PackedByteArray = FileAccess.get_file_as_bytes(path);bytes[12]=bytes[12]^1
	var file: FileAccess = FileAccess.open(path,FileAccess.WRITE);file.store_buffer(bytes);file.close()
	check.call("SAVE/generation_cache_rechecks_bytes_before_pruning",store.save(world).is_empty() and not store.verified_generations.has(path) and FileAccess.get_file_as_bytes(path)==bytes and store._generations().size()==4)
	world.step();store.save(world)
	check.call("SAVE/generation_cache_retains_three_valid_and_corrupt_evidence",store._generations().size()==4 and FileAccess.get_file_as_bytes(path)==bytes and load_saved(store).world.canonical_hash()==world.canonical_hash())

static func content3_upgrade(root: String, check: Callable) -> void:
	var audit: Dictionary = Content3Migration.audit()
	for row in audit.rows:
		check.call("SAVE/acknowledgement_migration_"+row.file,row.passed,str(row.get("error",row.get("preserved_gameplay_hash",""))))
	check.call("SAVE/all_reviewed_v3_and_foreign_acknowledgements_preserved",audit.passed and audit.rows.size()==6)
	var envelope: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/content3-hungry-cook.brackenward"))
	var changed: Dictionary = ColonyState.unpack(JSON.parse_string(envelope.payload))
	changed.content_hash="0".repeat(64);envelope.content_hash=changed.content_hash
	envelope.payload=JSON.stringify(ColonyState.pack(changed),"",true);envelope.sha256=envelope.payload.sha256_text()
	check.call("SAVE/v3_upgrade_requires_its_exact_released_catalog",ColonyCodec.decode(JSON.stringify(envelope,"",true).to_utf8_buffer()).get("error","").begins_with("Unknown released v3 catalog"))
	envelope.content="colony-v6"
	var newer: String = ColonyCodec.decode(JSON.stringify(envelope,"",true).to_utf8_buffer()).get("error","")
	check.call("SAVE/newer_content_error_identifies_required_and_supported_versions",newer.contains("colony-v6") and newer.contains("colony-v5"))
	var store: ColonyStore = ColonyStore.new();store.directory=root.path_join("content-v4-upgrade")
	DirAccess.make_dir_recursive_absolute(store.directory)
	var snapshot: PackedByteArray = FileAccess.get_file_as_bytes("res://tests/fixtures/content3-delta-base.brackenward")
	var journal: PackedByteArray = FileAccess.get_file_as_bytes("res://tests/fixtures/content3-delta.frames")
	var manifest: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(Content3Migration.MANIFEST))
	check.call("SAVE/v3_delta_fixture_bytes_remain_frozen",FileAccess.get_sha256("res://tests/fixtures/content3-delta-base.brackenward")==manifest.delta["content3-delta-base.brackenward"] and FileAccess.get_sha256("res://tests/fixtures/content3-delta.frames")==manifest.delta["content3-delta.frames"])
	var snapshot_path: String = store.directory.path_join("snapshot-0000000001.brackenward")
	var journal_path: String = store.directory.path_join("journal-0000000001.frames")
	var file: FileAccess = FileAccess.open(snapshot_path,FileAccess.WRITE);file.store_buffer(snapshot);file.close()
	file=FileAccess.open(journal_path,FileAccess.WRITE);file.store_buffer(journal);file.close()
	var expected: Dictionary = ColonyCodec.decode(FileAccess.get_file_as_bytes("res://tests/fixtures/content3-delta-final.brackenward"))
	var recovered: Dictionary = store.load_latest()
	check.call("SAVE/v3_delta_folds_before_content_header_upgrade",expected.has("world") and recovered.has("world") and recovered.world.tick==2400 and recovered.world.canonical_hash()==expected.world.canonical_hash(),str(recovered.get("error","")))
	if not expected.has("world") or not recovered.has("world"): return
	check.call("SAVE/v3_delta_migration_retains_original_and_backup_bytes",FileAccess.get_file_as_bytes(snapshot_path)==snapshot and FileAccess.get_file_as_bytes(journal_path)==journal and FileAccess.get_file_as_bytes(store.directory.path_join("migration-backup-snapshot-0000000001.brackenward"))==snapshot and FileAccess.get_file_as_bytes(store.directory.path_join("migration-backup-journal-0000000001.frames"))==journal)
	var fresh: Dictionary = ColonyCodec.decode(FileAccess.get_file_as_bytes("res://tests/fixtures/content3-hungry-cook.brackenward"))
	for index in range(600): fresh.world.step()
	check.call("SAVE/acknowledged_v3_marker_is_not_replayed_under_v4_rules",fresh.world.canonical_hash()!=recovered.world.canonical_hash())
	var world: ColonyWorld = recovered.world
	for index in range(1200): world.step()
	check.call("SAVE/migrated_hungry_cook_can_recover_in_future_play",world.citizens[0].health==100 and world.citizens[0].fullness>350 and world.invariant_errors().is_empty(),str([world.citizens[0].fullness,world.citizens[0].activity]))
	var error: String = store.checkpoint(world)
	var reloaded: Dictionary = load_saved(store)
	check.call("SAVE/v4_post_upgrade_checkpoint_continues_exactly",error.is_empty() and reloaded.has("world") and reloaded.world.canonical_hash()==world.canonical_hash() and FileAccess.get_file_as_bytes(store.directory.path_join("migration-backup-snapshot-0000000001.brackenward"))==snapshot and FileAccess.get_file_as_bytes(store.directory.path_join("migration-backup-journal-0000000001.frames"))==journal,str(error))

static func load_saved(store: ColonyStore) -> Dictionary:
	var reader: ColonyStore = ColonyStore.new();reader.directory=store.directory
	return reader.load_latest()

static func ui(game: GameSession, check: Callable) -> void:
	game._replace_world(ColonyTests.world());game.close_inspector();game.close_sheet();game._tutorial_dismiss()
	game.save_local()
	var queue: GatedQueue = GatedQueue.new()
	game.save_queue=queue;game.journal_elapsed=0.0;game.autosave_elapsed=0.0
	game.durable_at=game.save_clock
	game.runner.set_speed(1)
	game._process(1.0)
	check.call("SAVE/UI_periodic_save_runs_on_worker",queue.busy() and game.runner.speed>0)
	for frame in range(4): await game.get_tree().process_frame
	check.call("SAVE/UI_frames_continue_during_slow_storage",queue.busy() and game.is_inside_tree())
	game._process(2.0)
	check.call("SAVE/UI_slow_storage_pauses_simulation_with_explanation",game.runner.speed==0 and game.notice.contains("Saving is slow") and queue.busy())
	game.set_speed(1)
	check.call("SAVE/UI_slow_storage_cannot_resume_before_durable_capture",game.runner.speed==0)
	queue.gate.post();game._finish_background_save(true)
	check.call("SAVE/UI_finished_older_save_keeps_newer_live_progress",game.world.tick>=game.store.journal_tick and not queue.busy())
	game.save_local()
	game.save_queue=ColonySaveQueue.new()
	game.set_speed(1)
	check.call("SAVE/UI_latest_verified_save_allows_explicit_resume",game.runner.speed==1)
	game.runner.pause()
	game.world.step();game._start_background_save(false)
	game.world.queue_command("preference",{"citizen":1,"category":"Cooking","value":3});game.world.step()
	var final_hash: String = game.world.canonical_hash()
	game.suspend()
	var recovered: Dictionary = load_saved(game.store)
	check.call("SAVE/UI_background_joins_writer_then_saves_latest_tick",not game.save_queue.busy() and game.runner.speed==0 and recovered.has("world") and recovered.world.canonical_hash()==final_hash)
	game.resume_from_background();game.close_sheet()
	check.call("SAVE/UI_background_return_remains_paused",game.runner.speed==0 and game.world.canonical_hash()==final_hash)
	game.begin_field();game.view.preview_start=Vector2i(90,80);game.view.preview_end=Vector2i(91,80);game.confirm_placement()
	var paused_tick: int=game.world.tick;var queued_hash: String=game.world.canonical_hash()
	game.journal_elapsed=1.0;game._process(0.0)
	check.call("SAVE/UI_paused_new_order_starts_durable_capture_without_a_tick",game.save_queue.busy() and game.world.tick==paused_tick and game.world.pending_commands.size()==1)
	game._finish_background_save(true)
	recovered=load_saved(game.store)
	check.call("SAVE/UI_paused_queued_order_recovers_exactly_at_same_tick",recovered.has("world") and recovered.world.canonical_hash()==queued_hash and game.world.tick==paused_tick and game.store.journal_tick==paused_tick)
	game.begin_placement();game.view.preview_start=Vector2i(93,80);game.view.preview_end=Vector2i(94,80);game.confirm_placement()
	queued_hash=game.world.canonical_hash();game.journal_elapsed=1.0;game._process(0.0);game._finish_background_save(true);recovered=load_saved(game.store)
	check.call("SAVE/UI_second_paused_order_also_recovers_without_running",recovered.has("world") and recovered.world.canonical_hash()==queued_hash and recovered.world.pending_commands.size()==2 and game.world.tick==paused_tick)

