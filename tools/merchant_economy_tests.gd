class_name MerchantEconomyTests
extends RefCounted
## Bounded policy/transaction tests use synthetic setup; not campaign evidence.
static func run(check: Callable) -> void:
	var world: ColonyWorld=ColonyTests.world()
	var before: Dictionary=world.payload().duplicate(true)
	var policy: MerchantEconomyPolicy=MerchantEconomyPolicy.new();policy.plan(world)
	var after: Dictionary=world.payload().duplicate(true)
	for field in ["pending_commands","next_command_id"]:before.erase(field);after.erase(field)
	check.call("ECONOMY/planning_only_queues_public_commands",before==after and not world.pending_commands.is_empty() and world.pending_commands.all(func(c:Dictionary)->bool:return c.kind in ["preference","field","research_select"]))
	world=ColonyTests.world();policy=MerchantEconomyPolicy.new()
	var merchant: Dictionary=TradeTests.merchant(world,"riverward")
	var unchanged: String=world.canonical_hash();policy._buy_cloth(world)
	check.call("ECONOMY/import_waits_for_real_payment_and_building_reserve",world.canonical_hash()==unchanged and world.pending_commands.is_empty())
	# Unit fixture supplies only; the ordinary scenario never calls this setup.
	world._make_stack("wood",100,"store",ColonyTrade.cart(world).id,Vector2i(66,63),true)
	policy._buy_cloth(world)
	check.call("ECONOMY/exact_eight_cloth_for_forty_wood_at_current_reputation",world.pending_commands.size()==1 and world.pending_commands[0].kind=="trade" and world.pending_commands[0].args=={"target":merchant.id,"buy":{"cloth":8},"pay":{"wood":40},"pen":0,"delivery":false})
	unchanged=world.canonical_hash();policy._buy_cloth(world)
	check.call("ECONOMY/pending_purchase_cannot_be_queued_twice",world.canonical_hash()==unchanged)
	var recovered: Dictionary=ColonyCodec.decode(ColonyCodec.encode(world))
	if not recovered.has("world"):check.call("ECONOMY/paused_policy_resume_setup",false,str(recovered));return
	var resumed: MerchantEconomyPolicy=MerchantEconomyPolicy.new();resumed.resume(recovered.world,policy.decisions);resumed._buy_cloth(recovered.world)
	check.call("ECONOMY/paused_recovery_does_not_duplicate_purchase",recovered.world.canonical_hash()==world.canonical_hash())
	world.step();var exchange: Dictionary=world.trade_state.exchanges[0]
	unchanged=world.canonical_hash();policy._buy_cloth(world)
	check.call("ECONOMY/packing_purchase_counts_toward_target_and_one_visit_limit",exchange.state=="Packing" and world.pending_commands.is_empty() and world.canonical_hash()==unchanged)
	TradeTests.finish(world,exchange);unchanged=world.canonical_hash();policy._buy_cloth(world)
	check.call("ECONOMY/real_delivered_purchase_waits_for_a_different_merchant",exchange.state=="Complete" and world.ledger.traded_in.cloth==8 and world.ledger.traded_out.wood==40 and world.canonical_hash()==unchanged)
	merchant.state="Gone";var second: Dictionary=TradeTests.merchant(world,"riverward");policy._buy_cloth(world)
	check.call("ECONOMY/next_visit_buys_only_remaining_target",world.pending_commands.size()==1 and world.pending_commands[0].args.target==second.id and world.pending_commands[0].args.buy=={"cloth":8} and world.pending_commands[0].args.pay=={"wood":40})
	world.step();TradeTests.finish(world,world.trade_state.exchanges[1]);unchanged=world.canonical_hash();policy._buy_cloth(world)
	check.call("ECONOMY/two_real_receipts_stop_further_imports",world.trade_state.exchanges.all(func(e:Dictionary)->bool:return e.state=="Complete" and e.receipt>0) and world.ledger.traded_in.cloth==16 and world.ledger.traded_out.wood==80 and world.canonical_hash()==unchanged and world.invariant_errors().is_empty())
	world=ColonyTests.world();policy=MerchantEconomyPolicy.new();unchanged=world.canonical_hash();policy._fields(world,"flax",12,false)
	check.call("ECONOMY/policy_cannot_substitute_local_flax_for_imports",world.canonical_hash()==unchanged)
	world._structure("loom",Vector2i(90,80),0);policy._orders(world,4)
	check.call("ECONOMY/crafting_requests_sewing_without_local_weaving",world.pending_commands.any(func(c:Dictionary)->bool:return c.kind=="recipe_order" and c.args.definition=="sew_cloak") and not world.pending_commands.any(func(c:Dictionary)->bool:return c.kind=="recipe_order" and c.args.definition=="weave_cloth"))
	world=ColonyTests.world();policy=MerchantEconomyPolicy.new();merchant=TradeTests.merchant(world,"road_fellowship")
	unchanged=world.canonical_hash();policy._deliver_cloaks(world)
	check.call("ECONOMY/worn_starting_cloaks_cannot_pay_a_delivery",world.canonical_hash()==unchanged and world.available("cloak")==0)
	world._make_stack("cloak",3,"store",ColonyTrade.cart(world).id,Vector2i(66,63),true)
	policy._deliver_cloaks(world);unchanged=world.canonical_hash();policy._deliver_cloaks(world)
	check.call("ECONOMY/exact_spare_cloak_delivery_queues_only_once",world.pending_commands.size()==1 and world.pending_commands[0].args=={"target":merchant.id,"buy":{},"pay":{"cloak":3},"pen":0,"delivery":true} and world.canonical_hash()==unchanged)
	world.step();exchange=world.trade_state.exchanges[0];TradeTests.finish(world,exchange)
	check.call("ECONOMY/physical_cloak_delivery_earns_one_reputation_receipt",exchange.state=="Complete" and exchange.receipt>0 and world.trade_state.reputation.road_fellowship==30 and world.ledger.traded_out.cloak==3 and world.citizens.all(func(c:Dictionary)->bool:return c.equipment.cloak=="cloak") and world.invariant_errors().is_empty())
