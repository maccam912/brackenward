extends SceneTree
## Frozen content-v6 acknowledgements before correcting hostile self-defense.
const SOURCE: String="e4003fb1eb532f76b2d747975075244f09a221d4"
const DIRECTORY: String="res://tests/fixtures/content6/"
var entries: Array=[]
func _initialize() -> void:call_deferred("run")
func write_snapshot(world: ColonyWorld, name: String, role: String) -> void:
	var bytes: PackedByteArray=ColonyCodec.encode(world)
	write_bytes(name,bytes)
	entries.append({"file":"content6/"+name,"sha256":FileAccess.get_sha256(DIRECTORY+name),"canonical_hash":world.canonical_hash(),"role":role})
func write_bytes(name: String, bytes: PackedByteArray) -> void:
	var path: String=DIRECTORY+name;assert(not FileAccess.file_exists(path))
	var file: FileAccess=FileAccess.open(path,FileAccess.WRITE);assert(file!=null);file.store_buffer(bytes);file.close()
	assert(FileAccess.get_file_as_bytes(path)==bytes)
func controlled(near_goods: bool) -> ColonyWorld:
	var world: ColonyWorld=ColonyTests.world();world.session_id="content6-counterattack-"+("near" if near_goods else "far")
	var raid: Dictionary=DefenseTests.raid(world)
	var enemy: Dictionary=world.defense_state.enemies[0];enemy.x=20;enemy.y=20
	var person: Dictionary=world.citizens[1];person.x=21;person.y=20;person.edge_x=21;person.edge_y=20;person.drafted=true;person.route.clear();person.progress=0
	var stack: Dictionary=world.stacks.filter(func(s:Dictionary)->bool:return s.item=="meal")[0]
	if near_goods:stack.x=22;stack.y=20
	enemy.target_stack=stack.id;enemy.last_attacker=person.id
	ColonyCombat.resolve(world)
	assert(world.invariant_errors().is_empty() and enemy.health==36 and person.health==(95 if near_goods else 100) and enemy.cooldown==(1825 if near_goods else 0))
	return world
func run() -> void:
	var output: Array=[]
	if ColonyWorld.CONTENT_VERSION!="colony-v6" or OS.execute("git",["rev-parse","HEAD"],output,true)!=0 or str(output[0]).strip_edges()!=SOURCE or OS.execute("git",["diff","--exit-code","HEAD","--","src","data","project.godot"],[],true)!=0:
		printerr("Requires unmodified frozen e4003fb / content v6; never regenerate under corrected future combat");quit(2);return
	if DirAccess.dir_exists_absolute(DIRECTORY):printerr("Evidence directory already exists; never overwrite");quit(2);return
	var input: Dictionary=ColonyState.unpack(JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/campaign-replay-v6-input.json")))
	var golden: Dictionary=ColonyState.unpack(JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/campaign-replay-v6-golden.json")))
	var initial: ColonyWorld=ColonyWorld.new(ColonyCatalog.load_data(),input.campaign_id)
	assert(ColonyGeneration.configure(initial,input.seed,input.site,1).is_empty() and initial.canonical_hash()==golden.initial_hash)
	var foreign_path: String="res://tests/fixtures/campaign-replay-v6-7200.brackenward"
	var foreign: Dictionary=ColonyCodec.decode(FileAccess.get_file_as_bytes(foreign_path));assert(foreign.has("world") and FileAccess.get_sha256(foreign_path)==golden.save_fixture_sha256 and foreign.world.canonical_hash()==golden.checkpoints[0].canonical_hash)
	var endpoint_bytes: PackedByteArray=FileAccess.get_file_as_bytes("res://reports/snapshot-capture-v56-replay-72000.brackenward")
	var endpoint: Dictionary=ColonyCodec.decode(endpoint_bytes);assert(endpoint.has("world") and endpoint.world.canonical_hash()==golden.checkpoints[1].canonical_hash)
	var far: ColonyWorld=controlled(false);var near: ColonyWorld=controlled(true)
	assert(DirAccess.make_dir_recursive_absolute(DIRECTORY)==OK)
	write_snapshot(initial,"replay-initial.brackenward","Reviewed initial generator-1 v6 replay world")
	entries.append({"file":foreign_path.get_file(),"sha256":golden.save_fixture_sha256,"canonical_hash":foreign.world.canonical_hash(),"role":"Existing foreign-host v6 tick7200 bytes retained unchanged"})
	write_bytes("replay-72000.brackenward",endpoint_bytes)
	entries.append({"file":"content6/replay-72000.brackenward","sha256":FileAccess.get_sha256(DIRECTORY+"replay-72000.brackenward"),"canonical_hash":endpoint.world.canonical_hash(),"role":"Actual reviewed 62-command v6 tick72000 endpoint; original generated bytes copied"})
	write_snapshot(far,"far-goods-counterattack.brackenward","Controlled adjacent guard/clear sight, goods 88 tiles away: acknowledged v6 unanswered strike, not balance evidence")
	write_snapshot(near,"near-goods-counterattack.brackenward","Controlled adjacent guard/clear sight, goods one tile away: acknowledged v6 simultaneous damage, not balance evidence")
	var scratch: String="user://record-content6-%d" % Time.get_ticks_usec()
	var store: ColonyStore=ColonyStore.new();store.directory=scratch;assert(store.save(far).is_empty())
	for index in range(600):
		far.step()
		if index%120==119:assert(store.checkpoint(far).is_empty())
	assert(far.tick==2400 and far.invariant_errors().is_empty())
	write_snapshot(far,"delta-final.brackenward","600 acknowledged v6 ticks after an intercepted raider strike; exact old future retained")
	var delta: Dictionary={}
	for pair in [["snapshot-0000000001.brackenward","delta-base.brackenward"],["journal-0000000001.frames","delta.frames"]]:
		write_bytes(pair[1],FileAccess.get_file_as_bytes(scratch.path_join(pair[0])));delta["content6/"+pair[1]]=FileAccess.get_sha256(DIRECTORY+pair[1])
	delta["content6/delta-final.brackenward"]=FileAccess.get_sha256(DIRECTORY+"delta-final.brackenward")
	var loaded: Dictionary=store.load_latest();assert(loaded.has("world") and loaded.world.canonical_hash()==far.canonical_hash())
	var manifest: Dictionary={"source_commit":SOURCE,"content":"colony-v6","schema":23,"catalog_hash":far.definitions.content_hash,"producer_sha256":FileAccess.get_sha256(get_script().resource_path),"scope":"Exact v6 replay and controlled combat acknowledgements captured before correcting self-defense. No future-rule replay or ordinary campaign certification.","snapshots":entries,"delta":delta,"controlled_final_tick":far.tick,"controlled_final_health":far.citizens.map(func(p:Dictionary)->int:return p.health)}
	var file: FileAccess=FileAccess.open(DIRECTORY+"preservation.json",FileAccess.WRITE);assert(file!=null);file.store_string(JSON.stringify(manifest,"\t",true)+"\n");file.close()
	CampaignTests.remove_tree(scratch);print(JSON.stringify(manifest));quit(0)
