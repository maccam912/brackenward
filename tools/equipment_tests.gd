class_name EquipmentTests
extends RefCounted

static func run(check: Callable) -> void:
	WheelbarrowTests.run(check)
	var world: ColonyWorld = ColonyTests.world()
	check.call("GEAR/replacements_on_upgrades_off",world.equipment_state.values().all(func(slots:Dictionary)->bool:return slots.values().all(func(p:Dictionary)->bool:return p.replacements and not p.upgrades)))
	world._make_stack("forged_toolkit",1,"store",world.stores[0].id,Vector2i(66,63),true)
	for i in range(100): world.step()
	check.call("GEAR/no_unrequested_upgrade",world.citizens.all(func(c:Dictionary)->bool:return c.equipment.toolkit=="toolkit") and world.jobs.all(func(j:Dictionary)->bool:return j.kind!="equip"))
	world.queue_command("equip",{"target":1,"slot":"toolkit","item":"forged_toolkit"})
	for i in range(200): world.step()
	check.call("GEAR/two_wu_physical_manual_upgrade",world.citizens[0].equipment.toolkit=="forged_toolkit" and world.jobs.any(func(j:Dictionary)->bool:return j.kind=="equip" and j.required==2000 and j.state=="Complete"))
	check.call("GEAR/old_tool_returned_without_duplication",world.total("toolkit")==4 and world.available("toolkit")==1 and world.total("forged_toolkit")==1 and world.ledger.consumed.get("forged_toolkit",0)==0 and world.invariant_errors().is_empty(),str(world.invariant_errors()))
	var decoded: Dictionary = ColonyCodec.decode(ColonyCodec.encode(world))
	check.call("SAVE/gear_slots_and_policy_roundtrip",decoded.has("world") and decoded.world.canonical_hash()==world.canonical_hash(),str(decoded.get("error","")))
	world=ColonyTests.world();world._make_stack("forged_toolkit",1,"store",world.stores[0].id,Vector2i(66,63),true)
	world.queue_command("equipment_policy",{"target":1,"slot":"toolkit","replacements":true,"upgrades":true})
	for i in range(250): world.step()
	check.call("GEAR/explicit_auto_upgrade_changes_only_enabled_slot",world.citizens[0].equipment.toolkit=="forged_toolkit" and world.citizens.slice(1).all(func(c:Dictionary)->bool:return c.equipment.toolkit=="toolkit"))
	world=ColonyTests.world();world._make_stack("vest",1,"output",world.structures[5].id,Vector2i(70,62),true)
	for i in range(300): world.step()
	check.call("GEAR/empty_vest_slot_auto_equips_one_wearer",world.citizens.filter(func(c:Dictionary)->bool:return c.equipment.vest=="vest").size()==1 and world.total("vest")==1 and world.invariant_errors().is_empty(),str(world.invariant_errors()))
	world=ColonyTests.world();world.queue_command("equip",{"target":1,"slot":"weapon","item":""})
	for i in range(250): world.step()
	check.call("GEAR/unequip_stops_automatic_replacement",world.citizens[0].equipment.weapon.is_empty() and not world.equipment_state[1].weapon.replacements and world.total("spear")==2 and world.available("spear")==1 and world.invariant_errors().is_empty(),str(world.invariant_errors()))
	world=ColonyTests.world();world._make_stack("bow",1,"store",world.stores[0].id,Vector2i(66,63),true)
	world.queue_command("equip",{"target":1,"slot":"weapon","item":"bow"})
	for i in range(250): world.step()
	check.call("GEAR/weapon_choice_is_explicit",world.citizens[0].equipment.weapon=="bow" and world.equipment_state[1].weapon.preferred=="bow" and world.total("bow")==3 and world.total("spear")==2)
	world=ColonyTests.world();world._make_stack("forged_toolkit",1,"ground",0,Vector2i(75,55),true)
	world.queue_command("equip",{"target":1,"slot":"toolkit","item":"forged_toolkit"});world.step()
	var equip: Dictionary = world.jobs.filter(func(j:Dictionary)->bool:return j.kind=="equip")[0]
	check.call("GEAR/other_worker_cannot_steal_wearer_job",not world._reserve(equip,world.citizens[1]) and equip.worker==0)
	for i in range(400):
		world.step()
		if equip.state=="Delivering": break
	decoded=ColonyCodec.decode(ColonyCodec.encode(world))
	check.call("SAVE/carried_gear_roundtrip",equip.state=="Delivering" and decoded.has("world") and decoded.world.canonical_hash()==world.canonical_hash(),str(decoded.get("error","")))
	world.queue_command("cancel",{"target":equip.id});world.step()
	check.call("GEAR/cancel_keeps_old_slot_and_returns_new_item",world.citizens[0].equipment.toolkit=="toolkit" and world.total("forged_toolkit")==1 and world.invariant_errors().is_empty(),str(world.invariant_errors()))
	world=ColonyTests.world()
	var reject: int = world.queue_command("equip",{"target":1,"slot":"cloak","item":"spear"});world.step()
	check.call("GEAR/wrong_slot_rejected_without_work",world.receipts[reject].contains("fit") and world.jobs.is_empty())
	reject=world.queue_command("equip",{"target":1,"slot":"toolkit","item":"forged_toolkit"});world.step()
	check.call("GEAR/missing_item_explains_crafting_or_stock",world.receipts[reject].contains("accessible") and world.jobs.is_empty())
	world=ColonyTests.world();world.citizens[0].preferences.Hauling=0;world._make_stack("forged_toolkit",1,"store",world.stores[0].id,Vector2i(66,63),true)
	world.queue_command("equip",{"target":1,"slot":"toolkit","item":"forged_toolkit"})
	for i in range(200): world.step()
	check.call("GEAR/hauling_off_respected_and_job_waits",world.citizens[0].equipment.toolkit=="toolkit" and world.jobs.any(func(j:Dictionary)->bool:return j.kind=="equip" and j.worker==0))
	var old: Dictionary = ColonyCodec.decode(FileAccess.get_file_as_bytes("res://tests/fixtures/m4-care.brackenward"))
	check.call("SAVE/gear_migration_preserves_worn_items_and_care",old.has("world") and old.world.citizens[2].health==27 and old.world.citizens[0].equipment.toolkit=="toolkit" and old.world.equipment_state[1].toolkit.replacements)
	var bad: Dictionary = world.payload().duplicate(true);bad.equipment_state[1].weapon.preferred="medicine"
	check.call("SAVE/rejects_invalid_preferred_slot_item",ColonyCodec.restore(bad).has("error"))
